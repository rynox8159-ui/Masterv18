# Copy to .env for local development; never commit local credentials.
# Live Deriv pair data: ALL uses supported, non-OTC instruments.
# Candle streams are paced and cover the active eligible market universe by default.
DERIV_SYMBOLS=ALL
DERIV_CANDLE_SYMBOLS=ALL
DERIV_MAX_CANDLE_SYMBOLS=20

# MongoDB is the primary store. PostgreSQL is opt-in and optional.
# Local data stores and bounded worker/pool sizing (adjust for available RAM).
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=master_candel
MONGO_MIN_POOL_SIZE=1
MONGO_MAX_POOL_SIZE=20
MAX_AGENT_CONCURRENCY=5
SIGNAL_MAX_CONCURRENT_MARKETS=24
ONE_MINUTE_EVAL_MIN_LEAD=5
ONE_MINUTE_EVAL_MAX_LEAD=15
FIVE_MINUTE_EVAL_MIN_LEAD=5
FIVE_MINUTE_EVAL_MAX_LEAD=15

# Optional PostgreSQL mirror; enable only when a local PostgreSQL server is configured.
POSTGRES_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
POSTGRES_DB=deriv_signal_db
DATABASE_SSL=false
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5
POSTGRES_MIRROR_DERIV_ENABLED=true
POSTGRES_MIRROR_TICK_RETENTION_DAYS=7
POSTGRES_MIRROR_CANDLE_RETENTION_DAYS=30
POSTGRES_MIRROR_FLUSH_SECONDS=5

# Limit scheduled training refreshes on low-memory machines.
DEEP_MODEL_REFRESH_MAX_MARKETS=1
DEEP_MODEL_BOOTSTRAP_INTERVAL_SECONDS=60

# Required server-only login credential. Generate at least 32 random characters; never put this in frontend env or source.
BACKEND_API_KEY=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=7007
# ADMIN_DOWNLOAD_PASSWORD is no longer used: Project ZIP downloads need only the API key.
# Required by the remote observer browser; use SHA-256 of the same raw key below.
PROVIDER_CONTROL_KEY_SHA256=
PROVIDER_CONTROL_KEY=

# Deriv public app id (no account token is sent; data only)
DERIV_APP_ID=
# Signal loss guard: pause all signals for GUARD_GLOBAL_PAUSE_SECONDS after N losses in a row,
# max open signals at once, and hide pairs whose last GUARD_ROLLING_WINDOW results are below GUARD_MIN_WIN_RATE %.
GUARD_GLOBAL_LOSS_STREAK=2
GUARD_GLOBAL_PAUSE_SECONDS=1800
GUARD_MAX_OPEN_SIGNALS=2
GUARD_ROLLING_WINDOW=12
GUARD_MIN_SAMPLES=6
GUARD_MIN_WIN_RATE=55
# Quotex observer (optional auto-login; otherwise log in once in the Chromium window)
QX_EMAIL=
QX_PASSWORD=

# Quotex observer: proxy in a country where Quotex is available (needed on US/EU cloud servers).
# Format: http://user:pass@host:port  or  socks5://host:port
QX_PROXY=
# auto = headed Chromium on a virtual screen (Xvfb) when the server has no display; true = headless
QX_HEADLESS=auto
AUTOTRADE_WEB_LIVE_ENABLED=true
AUTOTRADE_WEB_REAL_CONTROL_KEY=change-me-real-trading-key
TRAIN_ALL_TIMEFRAMES=1m,5m
TRAIN_ALL_INTERVAL_SECONDS=86400
ALGO_LAYER_STRICT=true
ALGO_LAYER_MIN_EDGE=0.04
TRAIN_ALL_ON_STARTUP=true
TRAIN_ALL_STARTUP_DELAY_SECONDS=180
MARKET_FRESHNESS_SECONDS=45
DERIV_TICK_STALE_SECONDS=30
DERIV_HEARTBEAT_SILENCE_SECONDS=18
DERIV_RECONNECT_MAX_SECONDS=20

# ---- V16.8 ----
# Deriv account tokens for auto trade (demo = token 1, real = token 2). Never share this file with values filled in.
DERIV_API_TOKEN_1=
DERIV_API_TOKEN_2=
# Promotion gate (accuracy proof): a pair is PROMOTED only at >= PROMOTION_MIN_WIN_RATE % over >= PROMOTION_MIN_SAMPLES out-of-sample trades.
PROMOTION_MIN_WIN_RATE=58
PROMOTION_MIN_SAMPLES=300
PROMOTION_INTERVAL_SECONDS=21600
PROMOTION_STARTUP_DELAY_SECONDS=240
# Deriv active_symbols poll (open/closed flag per pair, new pairs). Seconds.
DERIV_MARKET_STATUS_INTERVAL_SECONDS=60
# Signal timeframes used by the engine and the promotion gate.
SIGNAL_TIMEFRAMES=1m,5m

# V17.1 signal gates: observe = pipeline-validated signals stay live and the gate verdict is recorded; enforce = hide gated signals
SIGNAL_PROMOTION_GATE=observe
SIGNAL_PRECISION_GATE=observe
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QX_OBSERVER_AUTOSTART=false
TRAINING_WORKERS=
TRAINING_THREADS=
TRAIN_PARALLEL_MARKETS=
TRAIN_BACKFILL_CANDLES=
TRAIN_INCREMENTAL_INTERVAL_SECONDS=
TRAIN_INCREMENTAL_MIN_OUTCOMES=
DERIV_DEMO_TOKEN=
DERIV_LIVE_TOKEN=
