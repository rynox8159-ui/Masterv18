# Backend receiving the observed market data.
# Leave empty on the same PC (uses BACKEND_PORT from backend/.env). For a remote backend:
# OBSERVER_BACKEND_URL=https://your-backend.example.com
# Quotex blocks many cloud/datacenter IPs: run the observer on your home PC or set a proxy.
# QX_PROXY=http://user:pass@host:port

# If the backend uses a custom key, set the same key in BACKEND_API_KEY here
# and in the backend's main_source_code/backend/.env file.
# BACKEND_API_KEY=

# Optional: use a remote-debugging Chrome instead of launching bundled Chromium.
# OBSERVER_MODE=ws_sniffer
# PLAYWRIGHT_CDP_URL=http://127.0.0.1:9222

# Optional: override where the persistent browser login profile is stored.
# QX_PROFILE_DIR=
